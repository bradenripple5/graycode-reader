JavaScriptfunction readGrayCodeAlongRadial(frameData, cx, cy, angle, trackRadii, bitSampleWidth = 9) {
  const bits = [];
  const twoPi = Math.PI * 2;
  let normAngle = angle % twoPi;
  if (normAngle < 0) normAngle += twoPi;

  const cos = Math.cos(normAngle);
  const sin = Math.sin(normAngle);

  const data = frameData.data;
  const w = frameData.width;
  const h = frameData.height;

  for (const r of trackRadii) {
    // sample a small line segment centered at r
    const half = bitSampleWidth >> 1;
    let sumGreen = 0, count = 0;

    for (let dr = -half; dr <= half; dr++) {
      const cr = r + dr * 0.7; // sub-pixel-ish step
      const px = Math.round(cx + cr * cos);
      const py = Math.round(cy + cr * sin);

      if (px < 0 || px >= w || py < 0 || py >= h) continue;

      const idx = (py * w + px) * 4;
      const g = data[idx + 1];
      sumGreen += g;
      count++;
    }

    if (count === 0) {
      bits.push(0); // or skip / error
      continue;
    }

    const avgG = sumGreen / count;
    // Tune thresholds based on your lighting — you can even adaptive threshold per radial
    bits.push(avgG > 100 ? 1 : 0); // example — white/reflective = 1, dark = 0 ?
